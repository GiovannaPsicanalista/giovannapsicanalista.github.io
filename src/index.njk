    .hero__ctas{display:flex;flex-wrap:wrap;align-items:center;gap:1.25rem}
    @media (max-width:920px){.hero{min-height:clamp(26rem,72vh,34rem)}.hero__foto{object-position:60% center}.hero::before{background:linear-gradient(to right,var(--cor-creme) 0%,var(--cor-creme) 44%,rgba(246,243,239,0.85) 100%),linear-gradient(to bottom,var(--cor-creme) 0%,rgba(246,243,239,0) 18%,rgba(246,243,239,0) 84%,var(--cor-creme) 100%)}}
    @media (max-width:1024px){.nav__toggle{display:inline-flex}.nav__lista{position:fixed;inset:4.5rem 0 auto 0;flex-direction:column;align-items:flex-start;gap:0;background:var(--cor-creme);border-bottom:var(--borda);box-shadow:var(--sombra);padding:0.5rem 1.5rem 1.5rem;transform:translateY(-120%);transition:transform 260ms ease}.nav[data-aberto="true"] .nav__lista{transform:translateY(0)}.nav__lista li{width:100%;border-bottom:var(--borda)}.nav__lista li:last-child{border-bottom:0}.nav__link{display:block;padding:0.9rem 0}.nav .btn{margin-top:1rem}}
